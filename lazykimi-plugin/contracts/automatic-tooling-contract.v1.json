{
  "schema": "lazykimi.automatic-tooling.contract",
  "schema_version": 1,
  "contract_version": "1.1.0",
  "description": "LazyKimi receipt-owned tooling lifecycle contract",
  "providers": {
    "ripgrep": { "kind": "local_binary", "commands": ["rg"], "network": "none" },
    "grep": { "kind": "local_binary", "commands": ["grep"], "network": "none" },
    "ast-grep": { "kind": "local_binary", "commands": ["sg"], "network": "none" },
    "typescript-language-server": { "kind": "local_service", "commands": ["typescript-language-server"], "network": "none" },
    "basedpyright": { "kind": "local_service", "commands": ["basedpyright"], "network": "none" },
    "codegraph": { "kind": "local_service", "commands": ["codegraph"], "network": "none" },
    "context7": { "kind": "remote_mcp", "endpoint": "https://mcp.context7.com/mcp", "network": "explicit" },
    "web": { "kind": "host_tool", "network": "host_governed" },
    "grep_app": { "kind": "remote_mcp", "endpoint": "https://mcp.grep.app", "network": "explicit" },
    "playwright": { "kind": "local_mcp", "package": "@playwright/mcp", "network": "explicit" },
    "filesystem": { "kind": "local_mcp", "network": "none" }
  },
  "capabilities": [
    { "id": "local_search", "providers": ["ripgrep", "grep"], "fallbacks": ["grep"] },
    { "id": "structural_search", "providers": ["ast-grep"], "fallbacks": ["local_search"] },
    { "id": "code_navigation", "providers": ["typescript-language-server", "basedpyright"], "fallbacks": ["structural_search", "local_search"] },
    { "id": "architecture_search", "providers": ["codegraph"], "fallbacks": ["code_navigation", "structural_search"] },
    { "id": "documentation_search", "providers": ["context7"], "fallbacks": ["web_search"] },
    { "id": "web_search", "providers": ["web"], "fallbacks": [] },
    { "id": "external_code_search", "providers": ["grep_app"], "fallbacks": ["web_search"] },
    { "id": "browser_automation", "providers": ["playwright"], "fallbacks": [] },
    { "id": "filesystem_read", "providers": ["filesystem"], "fallbacks": ["local_search"] }
  ],
  "fallback_chains": {
    "local_search": ["ripgrep", "grep"],
    "structural_search": ["ast-grep", "ripgrep"],
    "code_navigation": ["typescript-language-server", "basedpyright", "ast-grep", "ripgrep"],
    "architecture_search": ["codegraph", "typescript-language-server", "basedpyright", "ast-grep"],
    "documentation_search": ["context7", "web"],
    "web_search": ["web"],
    "external_code_search": ["grep_app", "web"],
    "browser_automation": ["playwright"],
    "filesystem_read": ["filesystem", "ripgrep"]
  },
  "permissions": {
    "filesystem_read": "default_allow",
    "network": "default_deny",
    "shell_exec": "default_deny"
  },
  "timeouts": {
    "default_seconds": 30,
    "network_seconds": 10
  },
  "error_codes": [
    { "code": "CAPABILITY_NOT_FOUND", "description": "requested capability is not declared in the canonical contract" },
    { "code": "PROVIDER_NOT_AVAILABLE", "description": "no provider for the capability is available on PATH or in the tooling root" },
    { "code": "PERMISSION_DENIED", "description": "policy denied the requested capability or provider invocation" },
    { "code": "TIMEOUT_EXCEEDED", "description": "provider invocation exceeded the configured timeout" },
    { "code": "NETWORK_NOT_ALLOWED", "description": "network access requires explicit provider selection" },
    { "code": "TOOLING_ROOT_NOT_EMPTY", "description": "tooling root must be empty or receipt-owned before install" },
    { "code": "RECEIPT_MISMATCH", "description": "tooling root receipt is stale, modified, or mismatched" },
    { "code": "CONTRACT_VERSION_MISMATCH", "description": "contract version does not match the broker's expected version" }
  ],
  "provenance": {
    "source": "lazykimi-automatic-tooling",
    "provider_pinning": "packages are version-pinned; remote endpoints are declared, not downloaded during validation",
    "integrity": "sha256_sidecar_required"
  },
  "automatic_provisioning": {
    "local_foundation": {
      "providers": ["ripgrep", "ast-grep", "typescript-language-server", "basedpyright"],
      "install_and_use": "allowed_without_interruption",
      "destination": "private_receipt_owned_lazykimi_tooling_root",
      "forbid_writes": ["target_repository_dependencies", "target_repository_lockfiles", "host_configuration"]
    },
    "ask_once": {
      "providers": ["codegraph", "playwright"],
      "conditions": ["unusual_large_tooling_or_models", "outside_root_access"]
    },
    "remote": {
      "costs": "ask_once",
      "credentials_or_auth": "ask_once",
      "egress": "explicit_provider_selection"
    }
  }
}
