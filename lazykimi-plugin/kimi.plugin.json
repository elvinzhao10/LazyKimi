{
  "name": "lazykimi",
  "version": "0.2.0",
  "description": "Kimi-native evidence-led agent workflow harness for Kimi Code CLI and Kimi Work.",
  "author": "LazyKimi contributors",
  "homepage": "https://github.com/elvinzhao10/LazyKimi",
  "license": "MIT",
  "keywords": [
    "kimi",
    "kimi-code",
    "kimi-work",
    "agent-workflow",
    "evidence-led"
  ],
  "interface": {
    "displayName": "LazyKimi",
    "shortDescription": "Evidence-led agent workflow harness for Kimi hosts",
    "longDescription": "LazyKimi recreates the LazyBuddy/LazyTrae evidence-led agent workflow harness design as a Kimi-native package. Primary host: Kimi Code CLI. Secondary host: Kimi Work (skills import only).",
    "developerName": "LazyKimi contributors",
    "websiteURL": "https://github.com/elvinzhao10/LazyKimi"
  },
  "skills": "./.kimi-code/skills/",
  "sessionStart": {
    "skill": "lazy-init-deep"
  },
  "skillInstructions": "LazyKimi skills use the lazy-* namespace and the .lazykimi/ state directory. Run /lazy-init-deep on first use.",
  "mcpServers": {
    "lazykimi-run-ledger": {
      "type": "stdio",
      "command": "python3",
      "args": ["./mcp/run-ledger/server.py"],
      "required": false
    },
    "lazykimi-verification": {
      "type": "stdio",
      "command": "python3",
      "args": ["./mcp/verification/server.py"],
      "required": false
    },
    "lazykimi-status-dashboard": {
      "type": "stdio",
      "command": "python3",
      "args": ["./mcp/status-dashboard/server.py"],
      "required": false
    },
    "lazykimi-context-graph": {
      "type": "stdio",
      "command": "python3",
      "args": ["./mcp/context-graph/server.py"],
      "required": false
    },
    "lazykimi-code-intel": {
      "type": "stdio",
      "command": "python3",
      "args": ["./mcp/code-intel/server.py"],
      "required": false
    },
    "lazykimi-docs": {
      "type": "stdio",
      "command": "python3",
      "args": ["./mcp/docs/server.py"],
      "required": false
    }
  },
  "hooks": [
    {
      "event": "SessionStart",
      "command": "bash ./hooks/session-start.sh",
      "timeout": 10
    },
    {
      "event": "UserPromptSubmit",
      "command": "bash ./hooks/user-prompt-submit.sh",
      "timeout": 5
    },
    {
      "event": "PreToolUse",
      "matcher": "Bash",
      "command": "bash ./hooks/pre-tool-use.sh",
      "timeout": 5
    },
    {
      "event": "PostToolUse",
      "command": "bash ./hooks/post-tool-use.sh",
      "timeout": 5
    },
    {
      "event": "Stop",
      "command": "bash ./hooks/stop-gate.sh",
      "timeout": 10
    },
    {
      "event": "SubagentStop",
      "command": "bash ./hooks/subagent-stop.sh",
      "timeout": 5
    },
    {
      "event": "PreCompact",
      "command": "bash ./hooks/pre-compact.sh",
      "timeout": 5
    },
    {
      "event": "PostCompact",
      "command": "bash ./hooks/post-compact.sh",
      "timeout": 5
    }
  ],
  "commands": "./.kimi-code/commands/"
}
