{
  "name": "lazykimi",
  "version": "1.3.3",
  "description": "LazyKimi evidence-gated planning, execution, and review workflows for Kimi hosts.",
  "author": "LazyKimi contributors",
  "homepage": "https://github.com/elvinzhao10/LazyKimi",
  "license": "MIT",
  "keywords": [
    "kimi",
    "kimi-code",
    "kimi-work",
    "agent-workflow",
    "evidence-led"
  ],
  "interface": {
    "displayName": "LazyKimi",
    "shortDescription": "Evidence-gated planning, execution, and review workflows for Kimi hosts",
    "longDescription": "LazyKimi ports the LazySeries evidence-gated planning, execution, and review workflow design to Kimi as a Kimi-native package at family parity with LazyZCode v1.3.3. Primary host: Kimi Code CLI (plugin manifest and project init routes). Secondary host: Kimi Work (skills import only).",
    "developerName": "LazyKimi contributors",
    "websiteURL": "https://github.com/elvinzhao10/LazyKimi"
  },
  "skills": "./.kimi-code/skills/",
  "sessionStart": {
    "skill": "lazy-init-deep"
  },
  "skillInstructions": "LazyKimi skills use the lazy-* namespace and the .lazykimi/ state directory. Run /lazy-init-deep on first use.",
  "mcpServers": {
    "lazykimi-run-ledger": {
      "command": "python3",
      "args": ["./mcp/run-ledger/server.py"]
    },
    "lazykimi-verification": {
      "command": "python3",
      "args": ["./mcp/verification/server.py"]
    },
    "lazykimi-status-dashboard": {
      "command": "python3",
      "args": ["./mcp/status-dashboard/server.py"]
    },
    "lazykimi-context-graph": {
      "command": "python3",
      "args": ["./mcp/context-graph/server.py"]
    },
    "lazykimi-code-intel": {
      "command": "python3",
      "args": ["./mcp/code-intel/server.py"]
    },
    "lazykimi-docs": {
      "command": "python3",
      "args": ["./mcp/docs/server.py"]
    }
  },
  "hooks": [
    {
      "event": "SessionStart",
      "command": "bash ./hooks/session-start.sh",
      "timeout": 10
    },
    {
      "event": "UserPromptSubmit",
      "command": "bash ./hooks/user-prompt-submit.sh",
      "timeout": 5
    },
    {
      "event": "PreToolUse",
      "matcher": "Write|Edit|Bash",
      "command": "bash ./hooks/pre-tool-use.sh",
      "timeout": 5
    },
    {
      "event": "PostToolUse",
      "command": "bash ./hooks/post-tool-use.sh",
      "timeout": 5
    },
    {
      "event": "Stop",
      "command": "bash ./hooks/stop-gate.sh",
      "timeout": 10
    },
    {
      "event": "SubagentStop",
      "command": "bash ./hooks/subagent-stop.sh",
      "timeout": 5
    },
    {
      "event": "PreCompact",
      "command": "bash ./hooks/pre-compact.sh",
      "timeout": 5
    },
    {
      "event": "PostCompact",
      "command": "bash ./hooks/post-compact.sh",
      "timeout": 5
    },
    {
      "event": "PostToolUseFailure",
      "command": "bash ./hooks/post-tool-use-failure.sh",
      "timeout": 5
    },
    {
      "event": "SessionEnd",
      "command": "bash ./hooks/session-end.sh",
      "timeout": 5
    },
    {
      "event": "SubagentStart",
      "command": "bash ./hooks/subagent-start.sh",
      "timeout": 5
    },
    {
      "event": "StopFailure",
      "command": "bash ./hooks/stop-failure.sh",
      "timeout": 5
    },
    {
      "event": "Interrupt",
      "command": "bash ./hooks/interrupt.sh",
      "timeout": 5
    },
    {
      "event": "PermissionRequest",
      "command": "bash ./hooks/permission-request.sh",
      "timeout": 5
    },
    {
      "event": "PermissionResult",
      "command": "bash ./hooks/permission-result.sh",
      "timeout": 5
    },
    {
      "event": "Notification",
      "command": "bash ./hooks/notification.sh",
      "timeout": 5
    }
  ],
  "commands": "./commands/"
}
