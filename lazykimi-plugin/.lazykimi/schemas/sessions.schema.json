{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lazykimi.dev/schemas/sessions.schema.json",
  "title": "Session Record",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "host": {
      "enum": ["kimi-code-cli", "kimi-work"]
    },
    "model": {
      "type": "string"
    },
    "work_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": ["session_id", "started_at", "host"]
}
