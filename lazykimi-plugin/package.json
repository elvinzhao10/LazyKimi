{
  "name": "lazykimi",
  "version": "1.3.4",
  "description": "Kimi-native evidence-led agent workflow harness (port of LazyBuddy/LazyTrae to Kimi Code CLI)",
  "type": "commonjs",
  "main": "dist/index.js",
  "bin": {
    "lazykimi": "dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "test": "LAZYKIMI_VERIFY_SUITE=all bash scripts/lazykimi-verify.sh",
    "smoke": "bash scripts/lazykimi-smoke-test.sh"
  },
  "keywords": [
    "kimi",
    "kimi-code",
    "agent",
    "workflow",
    "evidence-led",
    "swarm",
    "ultrawork"
  ],
  "license": "MIT",
  "files": [
    "dist",
    ".kimi-code",
    ".lazykimi/schemas",
    "agents",
    "hooks",
    "mcp",
    "commands",
    "scripts",
    "tooling",
    "contracts",
    "kimi.plugin.json",
    "NOTICE",
    "LICENSE"
  ],
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2"
  }
}
