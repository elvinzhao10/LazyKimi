{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lazykimi.dev/schemas/sessions.schema.json",
  "title": "Sessions Log",
  "type": "object",
  "properties": {
    "sessions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "event": {
            "type": "string"
          },
          "payload": {
            "type": "string"
          },
          "session_id": {
            "type": "string"
          },
          "started_at": {
            "type": "string",
            "format": "date-time"
          },
          "host": {
            "enum": ["kimi-code-cli", "kimi-work"]
          },
          "model": {
            "type": "string"
          },
          "work_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": ["timestamp", "event", "payload"]
      }
    }
  },
  "required": ["sessions"]
}
